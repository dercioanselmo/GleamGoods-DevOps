# Copy to .env and fill in real values. Never commit the real .env file.
#
# Postgres itself runs natively on the host (not in docker-compose) -
# already has the konecta-* databases with data, trust auth, user "apple",
# no password. See docker-compose.yml's SPRING_DATASOURCE_* env vars.

# New secret for this environment - do NOT reuse the AWS one (it's been
# pasted in chat/logs before and should be treated as compromised).
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Mailpit web UI basic auth, format "username:password".
MAILPIT_UI_AUTH=

# Same Google OAuth app already registered for
# https://konecta.dercioanselmo.com/login/oauth2/code/google - reused
# as-is since the tunnel keeps that same domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

